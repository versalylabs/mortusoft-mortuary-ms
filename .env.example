# Neon database URL without credentials or query parameters, used by the Neon Data API client.
NEXT_PUBLIC_NEON_URL=https://ep-example.c-2.us-east-2.aws.neon.tech/neondb

# Managed Better Auth values from Neon Console > Auth > Configuration.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Server-side Neon Postgres connection string (never expose with NEXT_PUBLIC_).
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage credentials are generated by `neon deploy` and should be kept server-side.
AWS_ACCESS_KEY_ID=generated-by-neon-deploy
AWS_SECRET_ACCESS_KEY=generated-by-neon-deploy
AWS_ENDPOINT_URL_S3=https://branch.storage.c-2.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
